# ---------------------------------------------------------------
# CodeQuest environment variables
# Copy to .env.local and fill in. NEVER commit .env or .env.local.
# ---------------------------------------------------------------

# PostgreSQL connection string.
# Local dev example (matches the commands in README):
DATABASE_URL="postgresql://codequest:CHANGE_ME@localhost:5432/codequest"

# Set to "true" when the database requires TLS (Supabase, Neon, RDS...).
DATABASE_SSL="false"

# Public origin of the app (used for absolute URLs and secure cookies).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Not used by the MVP yet (reserved for later phases):
# Judge0 / code execution service (Phase 2)
# JUDGE0_URL=""
# JUDGE0_API_KEY=""
# Redis for rate limiting / caching (Phase 3+)
# REDIS_URL=""
# Google OAuth (not implemented in MVP)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
